if(WIN32)
    set(_movie_platform windows)
else()
    set(_movie_platform linux)
endif()
set(ARCMP_FFMPEG_ROOT "${PROJECT_SOURCE_DIR}/build/deps/ffmpeg-${_movie_platform}" CACHE PATH "Pinned shared movie decoder")
if(NOT EXISTS "${ARCMP_FFMPEG_ROOT}/include/libavcodec/avcodec.h")
    message(FATAL_ERROR "Build the movie decoder first: python3 tools/build_movie_decoder.py --target ${_movie_platform}")
endif()
add_library(arcmp_movie STATIC src/media/movie.c)
target_include_directories(arcmp_movie PUBLIC src PRIVATE "${ARCMP_FFMPEG_ROOT}/include")
foreach(_movie_library avformat avcodec swresample swscale avutil)
    find_library(ARCMP_${_movie_library} NAMES ${_movie_library} PATHS "${ARCMP_FFMPEG_ROOT}/lib" NO_DEFAULT_PATH NO_CMAKE_FIND_ROOT_PATH REQUIRED)
    target_link_libraries(arcmp_movie PUBLIC "${ARCMP_${_movie_library}}")
endforeach()
target_link_libraries(tig PUBLIC arcmp_movie)
add_executable(arcmp-movie-probe tools/movie_probe.c)
target_link_libraries(arcmp-movie-probe PRIVATE arcmp_movie)
if(WIN32)
    file(GLOB _movie_dlls "${ARCMP_FFMPEG_ROOT}/bin/*.dll")
    add_custom_target(arcmp_movie_dlls ALL COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:arcanum-ce>"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${_movie_dlls} "$<TARGET_FILE_DIR:arcanum-ce>")
else()
    set_target_properties(arcanum-ce PROPERTIES BUILD_WITH_INSTALL_RPATH TRUE INSTALL_RPATH "$ORIGIN/lib")
    target_link_options(arcanum-ce PRIVATE "-Wl,--disable-new-dtags")
    file(GLOB _movie_candidates "${ARCMP_FFMPEG_ROOT}/lib/*.so.*")
    set(_movie_sonames)
    foreach(_movie_candidate IN LISTS _movie_candidates)
        if(_movie_candidate MATCHES "\\.so\\.[0-9]+$")
            list(APPEND _movie_sonames "${_movie_candidate}")
        endif()
    endforeach()
    add_custom_target(arcmp_movie_shared ALL COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:arcanum-ce>/lib"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${_movie_sonames} "$<TARGET_FILE_DIR:arcanum-ce>/lib")
endif()
